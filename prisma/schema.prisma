generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id String @id @default(uuid())
  username String @unique
  name String
  role String @default("Warehouse")
  warehouse String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id String @id @default(uuid())
  date String
  poNumber String @unique
  supplier String
  supplierAddress String?
  requisitioner String
  mrsNo String
  poExpDate String?
  poRvdDate String?
  pickupBy String?
  plateNumber String?
  approvedBy String?
  listedBy String?
  notes String?
  status String @default("incomplete")
  poType String @default("active-delivery")
  statusLabel String @default("Open")
  warehouse String

  monQtyRvd String?
  monDeliveredBy String?
  monDateDelivered String?
  monReferenceNo String?
  monDrDate String?
  monRemarks String?
  monPlateNumber String?

  profileId String?
  profile Profile? @relation(fields: [profileId], references: [id])
  items PurchaseOrderItem[]
  monitoringItems PurchaseOrderMonitoringItem[]
  deliveries Delivery[]
  // V1 procurement workflow (status is canonical; poType is category only)
  purchaseConfirmedAt DateTime?
  purchaseConfirmedBy String?
  readyForDeliveryAt DateTime?
  // Purchaser checkpoint: supplier has dispatched/is delivering purchased items.
  // Distinct from ready_for_delivery (ready to be sent). Set via markOnDelivery.
  onDeliveryAt DateTime?
  onDeliveryBy String?
  // Link to the source WarehouseRequest (reqNumber) for request-level
  // balances (requested vs received). Null for legacy/manual POs, which fall
  // back to an mrsNo lookup and then to PO quantities.
  sourceReqNumber String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PurchaseOrderItem {
  id String @id @default(uuid())
  poNumber String
  po PurchaseOrder @relation(fields: [poNumber], references: [poNumber], onDelete: Cascade)
  itemDescription String
  qty Int
  unit String
  // Actually purchased quantity (never overwrites qty); null until confirmPurchase
  purchasedQty Int?
  // Actually received quantity confirmed by Warehouse (simplified receiving,
  // NOT delivery tracking). 0 until receiving; never exceeds purchasedQty.
  receivedQty Int @default(0)
  // Optional link to the standardized Item Catalog entry.
  itemId String?
  item Item? @relation(fields: [itemId], references: [id])
  createdAt DateTime @default(now())
  monitoringItems PurchaseOrderMonitoringItem[]
  deliveryItems DeliveryItem[]
  @@index([poNumber])
}

// Standardized Item Catalog. `normalizedName` (lowercase + trimmed) enforces
// duplicate prevention across spelling/capitalization variations. `category`
// is free-text for now so it can later migrate to a controlled table.
// `aliases` holds alternate names for search.
model Item {
  id String @id @default(uuid())
  name String
  normalizedName String @unique
  unit String
  category String?
  active Boolean @default(true)
  aliases String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  purchaseOrderItems PurchaseOrderItem[]
  warehouseRequestItems WarehouseRequestItem[]
}

model PurchaseOrderMonitoringItem {
  id String @id @default(uuid())
  poNumber String
  poItemId String
  po PurchaseOrder @relation(fields: [poNumber], references: [poNumber], onDelete: Cascade)
  poItem PurchaseOrderItem @relation(fields: [poItemId], references: [id], onDelete: Cascade)
  qtyReceived Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([poItemId])
  @@index([poNumber])
}

model WarehouseRequest {
  id String @id @default(uuid())
  date String
  reqNumber String @unique
  mrsNo String
  requestedBy String
  requisitioner String
  warehouse String?
  status String @default("Pending")
  remarks String?
  followUpOfReqNumber String?
  followUpOfPoNumber String?
  items WarehouseRequestItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WarehouseRequestItem {
  id String @id @default(uuid())
  reqNumber String
  request WarehouseRequest @relation(fields: [reqNumber], references: [reqNumber], onDelete: Cascade)
  itemDescription String
  qty Int
  unit String
  approvedQty Int?
  // Optional link to the standardized Item Catalog entry.
  itemId String?
  item Item? @relation(fields: [itemId], references: [id])
  createdAt DateTime @default(now())
  @@index([reqNumber])
}

model Warehouse {
  id String @id @default(uuid())
  name String @unique
  createdAt DateTime @default(now())
}

model WarehouseArchive {
  id String @id @default(uuid())
  warehouseName String
  reason String
  clearedAt DateTime @default(now())
  poCount Int @default(0)
  requestCount Int @default(0)
  poData Json
  requestData Json
  createdAt DateTime @default(now())
}

model ArchiveActivityLog {
  id String @id @default(uuid())
  warehouseName String
  action String
  detail String?
  actor String?
  createdAt DateTime @default(now())
}

// V1 procurement → delivery → receiving (one PO → many deliveries).
// Supplier stays outside the system; DeliveryReceipt stores Storage paths only.
model Delivery {
  id String @id @default(uuid())
  deliveryNumber String @unique
  poNumber String
  po PurchaseOrder @relation(fields: [poNumber], references: [poNumber], onDelete: Cascade)
  reqNumber String?
  supplier String
  // for_delivery | in_transit | received | partially_received | discrepancy | completed
  status String @default("for_delivery")
  statusLabel String @default("For Delivery")
  deliveredBy String?
  plateNumber String?
  deliveryDate DateTime?
  supplierDrNumber String?
  receivedBy String?
  receivedAt DateTime?
  remarks String?
  items DeliveryItem[]
  receipts DeliveryReceipt[]
  auditLogs DeliveryAuditLog[]
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([poNumber])
}

model DeliveryItem {
  id String @id @default(uuid())
  deliveryId String
  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  poItemId String
  poItem PurchaseOrderItem @relation(fields: [poItemId], references: [id], onDelete: Cascade)
  // Snapshot of POItem.purchasedQty at delivery creation; never overwritten later
  purchasedQty Int
  deliveredQty Int
  receivedQty Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([deliveryId])
  @@index([poItemId])
}

model DeliveryReceipt {
  id String @id @default(uuid())
  deliveryId String
  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  // Private Supabase Storage path, e.g. DEL-2026-0018/<uuid>-supplier-dr.jpg
  storagePath String
  uploadedBy String?
  uploadedAt DateTime @default(now())
  @@index([deliveryId])
}

model DeliveryAuditLog {
  id String @id @default(uuid())
  deliveryId String?
  delivery Delivery? @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  poNumber String
  action String
  detail String?
  actor String?
  createdAt DateTime @default(now())
  @@index([poNumber])
  @@index([deliveryId])
}
