generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id String @id @default(uuid())
  username String @unique
  name String
  role String @default("Warehouse")
  warehouse String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id String @id @default(uuid())
  date String
  poNumber String @unique
  // Procurement-owned, NOT set at PO creation. Recorded when the purchaser
  // saves purchase quantities (see actions/procurement.ts savePurchase).
  // Nullable because an approved requirement has no supplier yet.
  supplier String?
  supplierAddress String?
  requisitioner String
  mrsNo String
  poExpDate String?
  poRvdDate String?
  pickupBy String?
  plateNumber String?
  approvedBy String?
  listedBy String?
  notes String?
  // Canonical lifecycle: awaiting_purchase -> in_progress -> completed
  // (+ cancelled). Legacy values (incomplete, purchase_confirmed,
  // ready_for_delivery, on_delivery) are read-only; see poLifecycle() in
  // src/lib/deliveryStatus.ts. statusLabel is display-only and always
  // derived from status by the UI, never trusted as stored.
  status String @default("awaiting_purchase")
  // @deprecated legacy category only; never a workflow or result state.
  poType String @default("active-delivery")
  statusLabel String @default("Awaiting Purchase")
  warehouse String

  monQtyRvd String?
  monDeliveredBy String?
  monDateDelivered String?
  monReferenceNo String?
  monDrDate String?
  monRemarks String?
  monPlateNumber String?

  profileId String?
  profile Profile? @relation(fields: [profileId], references: [id])
  items PurchaseOrderItem[]
  monitoringItems PurchaseOrderMonitoringItem[]
  // The supplier's signed delivery receipt: the evidence for how many units
  // were actually purchased against this PO. Optional — receiving never requires
  // one — but several may exist, one per receiving event.
  receipts PurchaseOrderReceipt[]
  // Historical shipment records. The active workflow no longer creates
  // these — supplier delivery is external to CARDS. Read-only archive.
  deliveries Delivery[]
  // First Save Purchase stamp (purchaser username).
  purchaseConfirmedAt DateTime?
  purchaseConfirmedBy String?
  // @deprecated retired delivery gates. Never written by the current
  // workflow; retained so historical rows keep their context.
  readyForDeliveryAt DateTime?
  // @deprecated retired "On Delivery" checkpoint. Retained for history only.
  onDeliveryAt DateTime?
  onDeliveryBy String?
  // Link to the source WarehouseRequest (reqNumber) for request-level
  // balances (requested vs received). Null for legacy/manual POs, which fall
  // back to an mrsNo lookup and then to PO quantities.
  sourceReqNumber String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PurchaseOrderItem {
  id String @id @default(uuid())
  poNumber String
  po PurchaseOrder @relation(fields: [poNumber], references: [poNumber], onDelete: Cascade)
  itemDescription String
  /// Approved quantity on this PO line (the snapshot the PO was raised for).
  qty Int
  unit String
  /// Cumulative quantity the purchaser has committed to buy so far. Never
  /// overwritten: each Save Purchase / Follow-up Purchase raises the total,
  /// capped at the approved quantity. Null until the first purchase.
  purchasedQty Int?
  /// Cumulative quantity the warehouse has physically received. Raised by
  /// each receiving event, capped at purchasedQty. 0 until something arrives.
  receivedQty Int @default(0)
  // Optional link to the standardized Item Catalog entry.
  itemId String?
  item Item? @relation(fields: [itemId], references: [id])
  createdAt DateTime @default(now())
  monitoringItems PurchaseOrderMonitoringItem[]
  deliveryItems DeliveryItem[]
  @@index([poNumber])
}

// The physical delivery receipt the supplier handed over, uploaded by the
// warehouse while recording receiving. It is the documentary evidence that a
// purchase was really made; the quantity chain remains the source of truth for
// what CARDS believes arrived, and this only evidences it.
//
// Deliberately its own model rather than another DeliveryReceipt row: the
// Delivery tables belong to a retired supplier-delivery workflow that the current
// process never writes, so a PO receipt has nothing to hang off there.
model PurchaseOrderReceipt {
  id String @id @default(uuid())
  poNumber String
  po PurchaseOrder @relation(fields: [poNumber], references: [poNumber], onDelete: Cascade)
  /// Object path inside the `delivery-receipts` Storage bucket, namespaced by PO.
  storagePath String
  uploadedBy String?
  uploadedAt DateTime @default(now())
  @@index([poNumber])
}

// Standardized Item Catalog. `normalizedName` (lowercase + trimmed) enforces
// duplicate prevention across spelling/capitalization variations. `category`
// is free-text for now so it can later migrate to a controlled table.
// `aliases` holds alternate names for search.
model Item {
  id String @id @default(uuid())
  name String
  normalizedName String @unique
  unit String
  category String?
  active Boolean @default(true)
  aliases String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  purchaseOrderItems PurchaseOrderItem[]
  warehouseRequestItems WarehouseRequestItem[]
}

model PurchaseOrderMonitoringItem {
  id String @id @default(uuid())
  poNumber String
  poItemId String
  po PurchaseOrder @relation(fields: [poNumber], references: [poNumber], onDelete: Cascade)
  poItem PurchaseOrderItem @relation(fields: [poItemId], references: [id], onDelete: Cascade)
  qtyReceived Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([poItemId])
  @@index([poNumber])
}

model WarehouseRequest {
  id String @id @default(uuid())
  date String
  reqNumber String @unique
  mrsNo String
  requestedBy String
  requisitioner String
  warehouse String?
  status String @default("Pending")
  remarks String?
  followUpOfReqNumber String?
  followUpOfPoNumber String?
  items WarehouseRequestItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WarehouseRequestItem {
  id String @id @default(uuid())
  reqNumber String
  request WarehouseRequest @relation(fields: [reqNumber], references: [reqNumber], onDelete: Cascade)
  itemDescription String
  qty Int
  unit String
  approvedQty Int?
  // Optional link to the standardized Item Catalog entry.
  itemId String?
  item Item? @relation(fields: [itemId], references: [id])
  createdAt DateTime @default(now())
  @@index([reqNumber])
}

model Warehouse {
  id String @id @default(uuid())
  name String @unique
  createdAt DateTime @default(now())
}

model WarehouseArchive {
  id String @id @default(uuid())
  warehouseName String
  reason String
  clearedAt DateTime @default(now())
  poCount Int @default(0)
  requestCount Int @default(0)
  poData Json
  requestData Json
  createdAt DateTime @default(now())
}

model ArchiveActivityLog {
  id String @id @default(uuid())
  warehouseName String
  action String
  detail String?
  actor String?
  createdAt DateTime @default(now())
}

// Historical shipment records (DEL-xxxx). The active workflow does NOT create
// these: supplier delivery is external to CARDS and the warehouse records
// receiving directly against PurchaseOrderItem.receivedQty. Tables and rows
// are preserved for historical record, reporting and archive viewing only.
// DeliveryAuditLog is still the live PO workflow audit log: poNumber is
// required and deliveryId is nullable, so purchase/receiving events are
// recorded with deliveryId = null.
model Delivery {
  id String @id @default(uuid())
  deliveryNumber String @unique
  poNumber String
  po PurchaseOrder @relation(fields: [poNumber], references: [poNumber], onDelete: Cascade)
  reqNumber String?
  supplier String
  // Archive-only: for_delivery | in_transit | received | partially_received
  // | discrepancy | completed
  status String @default("for_delivery")
  statusLabel String @default("For Delivery")
  deliveredBy String?
  plateNumber String?
  deliveryDate DateTime?
  supplierDrNumber String?
  receivedBy String?
  receivedAt DateTime?
  remarks String?
  items DeliveryItem[]
  receipts DeliveryReceipt[]
  auditLogs DeliveryAuditLog[]
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([poNumber])
}

model DeliveryItem {
  id String @id @default(uuid())
  deliveryId String
  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  poItemId String
  poItem PurchaseOrderItem @relation(fields: [poItemId], references: [id], onDelete: Cascade)
  // Snapshot of POItem.purchasedQty at delivery creation; never overwritten later
  purchasedQty Int
  deliveredQty Int
  receivedQty Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([deliveryId])
  @@index([poItemId])
}

model DeliveryReceipt {
  id String @id @default(uuid())
  deliveryId String
  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  // Private Supabase Storage path, e.g. DEL-2026-0018/<uuid>-supplier-dr.jpg
  storagePath String
  uploadedBy String?
  uploadedAt DateTime @default(now())
  @@index([deliveryId])
}

// Workflow audit log. Shared by the live procurement/receiving actions
// (purchase_saved, supplier_changed, receiving_recorded, po_completed) and
// the historical delivery archive. poNumber is always required; deliveryId is
// null for non-delivery events.
model DeliveryAuditLog {
  id String @id @default(uuid())
  deliveryId String?
  delivery Delivery? @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  poNumber String
  action String
  detail String?
  actor String?
  createdAt DateTime @default(now())
  @@index([poNumber])
  @@index([deliveryId])
}
