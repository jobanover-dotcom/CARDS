generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id        String   @id @default(uuid())
  username  String   @unique
  name      String
  role      String   @default("Warehouse")
  warehouse String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id              String  @id @default(uuid())
  date            String
  poNumber        String  @unique
  supplier        String
  supplierAddress String?
  requisitioner   String
  mrsNo           String
  poExpDate       String?
  poRvdDate       String?
  pickupBy        String
  plateNumber     String?
  approvedBy      String?
  listedBy        String?
  notes           String?
  status          String  @default("incomplete")
  poType          String  @default("active-delivery")
  statusLabel     String  @default("Open")
  warehouse       String

  monQtyRvd        String?
  monDeliveredBy   String?
  monDateDelivered String?
  monReferenceNo   String?
  monDrDate        String?
  monRemarks       String?

  profileId String?
  profile   Profile? @relation(fields: [profileId], references: [id])

  items PurchaseOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  poNumber        String
  po              PurchaseOrder @relation(fields: [poNumber], references: [poNumber], onDelete: Cascade)
  itemDescription String
  qty             Int
  unit            String
  createdAt       DateTime      @default(now())

  @@index([poNumber])
}

model WarehouseRequest {
  id                  String  @id @default(uuid())
  date                String
  reqNumber           String  @unique
  mrsNo               String
  requestedBy         String
  requisitioner       String
  warehouse           String?
  status              String  @default("Pending")
  remarks             String?
  followUpOfReqNumber String?    // follow-up of a previous REQUEST (partial approval)
  followUpOfPoNumber  String?    // follow-up of a PARTIALLY RECEIVED PO

  items WarehouseRequestItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WarehouseRequestItem {
  id              String           @id @default(uuid())
  reqNumber       String
  request         WarehouseRequest @relation(fields: [reqNumber], references: [reqNumber], onDelete: Cascade)
  itemDescription String
  qty             Int
  unit            String
  approvedQty     Int?
  createdAt       DateTime         @default(now())

  @@index([reqNumber])
}

model Warehouse {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model WarehouseArchive {
  id            String   @id @default(uuid())
  warehouseName String
  reason        String
  clearedAt     DateTime @default(now())
  poCount       Int      @default(0)
  requestCount  Int      @default(0)
  poData        Json
  requestData   Json
  createdAt     DateTime @default(now())
}

model ArchiveActivityLog {
  id            String   @id @default(uuid())
  warehouseName String
  action        String
  detail        String?
  actor         String?
  createdAt     DateTime @default(now())
}
