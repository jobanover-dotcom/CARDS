# ---- Supabase (auth + PostgreSQL) ----
# Project URL & anon key: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key: Supabase Dashboard → Settings → API (server-only, never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Database (Prisma) ----
# Use the connection pooler URL: Supabase Dashboard → Connect → Connection pooling
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# If you hit "too many connections" in serverless environments, switch port 5432 → 6543 and append ?pgbouncer=true

# ---- AI Orchestration (LiteLLM) ----
# Priority: 1. Gemini 1.5 Flash (1.5B tokens/mo free) → 2. Groq Llama 3.1 70B (1,000 req/day) → 3. Nemotron 3 Ultra (free via OpenRouter)
# Get keys at:
#   GEMINI_API_KEY: https://aistudio.google.com/apikey
#   GROQ_API_KEY: https://console.groq.com/keys
#   OPENROUTER_API_KEY: https://openrouter.ai/keys (includes Nemotron 3 Ultra FREE)
GEMINI_API_KEY=your-gemini-key-here
GROQ_API_KEY=your-groq-key-here
OPENROUTER_API_KEY=your-openrouter-key-here
